# All values are optional — users sign up in-app and connect Plex (or other
# services later) as an integration, no tokens need to go in this file.
# The TMDB API key is also configured in-app (Integrations page), not here.

POLL_INTERVAL_MINUTES=15
DASHBOARD_PORT=8000
HISTORY_LOOKBACK_DAYS=3650
LOG_LEVEL=INFO
